# =============================================================================
# Application Auth
# =============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-char-hex-secret

# =============================================================================
# Shopify App
# =============================================================================
SHOPIFY_API_KEY=replace-with-your-shopify-api-key
SHOPIFY_API_SECRET=replace-with-your-shopify-api-secret
SHOPIFY_APP_URL=http://localhost:3000
SHOPIFY_SCOPES=read_products,read_orders,write_products

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgresql://priceviewer:devpassword@localhost:5432/priceviewer
DATABASE_ECHO=false

# =============================================================================
# Application
# =============================================================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# =============================================================================
# Email (SMTP)
# =============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Price Intelligence

# =============================================================================
# Scraping
# =============================================================================
FIRECRAWL_API_KEY=replace-with-firecrawl-api-key
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
SERP_API_KEY=replace-with-serp-api-key
EXA_API_KEY=replace-with-exa-api-key
PLAYWRIGHT_HEADLESS=true
SCRAPING_TIMEOUT=30000
SCRAPING_RETRIES=3
MAX_CONCURRENT_SCRAPES=5

# =============================================================================
# OpenAI (for AI extraction & embeddings)
# =============================================================================
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# OpenRouter (free AI models for pricing recommendations)
# =============================================================================
# Sign up at https://openrouter.ai/keys to get an API key
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free model: mistralai/mistral-7b-instruct:free, google/gemma-7b-it:free
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# =============================================================================
# Encryption (PBKDF2 salt for token encryption)
# =============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY_SALT=replace-with-64-char-hex-salt

# =============================================================================
# Price Monitoring
# =============================================================================
MONITORING_INTERVAL_HOURS=1
MATCH_CONFIDENCE_THRESHOLD=0.85

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PRICE_ALERTS=true
ENABLE_RECOMMENDATIONS=true
