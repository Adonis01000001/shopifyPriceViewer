# =============================================================================
# Application Auth
# =============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-char-hex-secret

# =============================================================================
# Shopify App
# =============================================================================
SHOPIFY_API_KEY=replace-with-your-shopify-api-key
SHOPIFY_API_SECRET=replace-with-your-shopify-api-secret
SHOPIFY_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# Stripe Billing (create recurring Prices in Stripe and paste their IDs here)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
BILLING_REQUIRED=false
SHOPIFY_SCOPES=read_products

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgresql://priceviewer:devpassword@localhost:5432/priceviewer
DATABASE_ECHO=false
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
QUEUE_MODE=inline
WORKER_CONCURRENCY=4

# =============================================================================
# Application
# =============================================================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# =============================================================================
# Email (SMTP)
# =============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Price Intelligence

# =============================================================================
# Scraping
# =============================================================================
FIRECRAWL_API_KEY=replace-with-firecrawl-api-key
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
SERP_API_KEY=replace-with-serp-api-key
SERPAPI_MAX_CONCURRENCY=1
SERPAPI_MAX_RETRIES=2
SERPAPI_BASE_BACKOFF_MS=1000
SERPAPI_MAX_BACKOFF_MS=15000
# Successful responses are cached for this many seconds.
SERPAPI_CACHE_TTL=900
# Fail fast after account-level quota exhaustion for this many milliseconds.
SERPAPI_QUOTA_COOLDOWN_MS=21600000
# Serper is a cheaper Google search provider. Set it and it is preferred.
SERPER_API_KEY=
PLAYWRIGHT_HEADLESS=true
SCRAPING_TIMEOUT=30000
SCRAPING_RETRIES=3
MAX_CONCURRENT_SCRAPES=5

# =============================================================================
# OpenAI (for AI extraction & embeddings)
# =============================================================================
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODELS=gpt-5.6-luna,gpt-5.4

# =============================================================================
# OpenRouter (free AI models for pricing recommendations)
# =============================================================================
# Sign up at https://openrouter.ai/keys to get an API key
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Leave these blank for product extraction. The product pipeline is OpenAI-only.
OPENROUTER_MODEL=
OPENROUTER_MODELS=
# Maximum model calls in flight across cron jobs and user-triggered jobs.
LLM_MAX_CONCURRENCY=2
# Retries apply only to temporary rate limits. Daily quota errors are never retried.
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_MS=1500
# Maximum reduced product-page content sent to a model.
LLM_CONTENT_MAX_CHARS=6500
# Used only when a daily-quota response omits a valid reset timestamp.
LLM_QUOTA_FALLBACK_COOLDOWN_MS=21600000

# Sanitized failure-learning payload and asynchronous analysis controls.
SCRAPER_FAILURE_CONTENT_MAX_CHARS=12000
SCRAPER_IMPROVEMENT_MIN_FAILURES=5
SCRAPER_IMPROVEMENT_MAX_CLUSTERS=3
SCRAPER_IMPROVEMENT_INTERVAL_HOURS=24

# =============================================================================
# Encryption (PBKDF2 salt for token encryption)
# =============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY_SALT=replace-with-64-char-hex-salt

# =============================================================================
# Price Monitoring
# =============================================================================
# Automatic refresh is one wall-clock run per day. It does not run at startup.
PRICE_REFRESH_ENABLED=true
PRICE_REFRESH_HOUR=2
PRICE_REFRESH_MINUTE=0
PRICE_REFRESH_TIMEZONE=UTC
MONITORING_INTERVAL_HOURS=1
MATCH_CONFIDENCE_THRESHOLD=0.85

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PRICE_ALERTS=true
ENABLE_RECOMMENDATIONS=true
