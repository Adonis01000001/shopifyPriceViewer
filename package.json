{
  "name": "shopify-price-intelligence",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && pnpm run build:worker",
    "build:worker": "esbuild server/workers/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/worker.js",
    "build:all": "npm run build",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "worker": "cross-env NODE_ENV=production tsx server/workers/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "smoke": "node scripts/smoke-check.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "check": "tsc --noEmit",
    "typecheck": "npm run check",
    "format": "prettier --write .",
    "format:check": "prettier --check package.json server/_core/env.ts server/seed.ts drizzle/seed.ts server/test-login.ts scripts/smoke-check.mjs scripts/release-preflight.mjs server/_core/shopify-webhooks.ts server/_core/index.ts README.md docs/LAUNCH-READINESS-CHECKLIST.md docs/LEGAL-PRIVACY-INPUTS.md docs/RELEASE-DEPLOYMENT.md docs/RELEASE-PLAN-V1.md code.md .github/workflows/ci.yml",
    "lint": "eslint .",
    "test": "vitest run",
    "db:seed": "tsx server/seed.ts",
    "db:seed:electronics": "tsx server/seed-electronics.ts"
  },
